      "properties": {
        "idomap:type": "polygon",
        "idomap:layerId": "default",
        "idomap:label": "City walls of Pompeii",
        "idomap:description": "The defensive walls of Pompeii, built in successive phases from the 6th century BC onwards. About 3.2 km long, punctuated by seven gates and reinforced by a dozen towers, they defined the city until its destruction on 24 August 79 AD.",
        "idomap:order": 2,
        "idomap:legendEntryId": "0bf11c49-1a65-5331-859f-712cb6bc2189"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48485,
          40.74933
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Forum",
        "idomap:description": "The heart of Pompeii, a rectangular plaza about 38 × 142 m at the junction of the city's main axes. Surrounded by the city's most important civic, religious and commercial buildings. Closed to chariot traffic and paved in travertine slabs.",
        "idomap:order": 1,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48451,
          40.74995
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Capitolium (Temple of Jupiter)",
        "idomap:description": "The main temple of Pompeii, standing on a tall podium at the north end of the Forum with the Vesuvius rising dramatically behind it. Originally dedicated to the Capitoline triad — Jupiter, Juno and Minerva — after Pompeii became a Roman colony in 80 BC.",
        "idomap:order": 2,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48448,
          40.74874
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Basilica",
        "idomap:description": "The city's main courthouse and business exchange, built around 120 BC. One of the oldest known Roman basilicas and an architectural prototype for the later Christian basilicas of late antiquity.",
        "idomap:order": 3,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48512,
          40.75007
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Macellum",
        "idomap:description": "The covered food market of Pompeii, opening onto the east side of the Forum. Stalls sold fish, meat and produce; a central tholos held a fish-scaling basin whose drain is still visible.",
        "idomap:order": 4,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48559,
          40.74942
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Building of Eumachia",
        "idomap:description": "A grand portico built by the priestess Eumachia, patroness of the fullers (launderers) guild. Its monumental marble doorframe is decorated with exquisite acanthus scrolls.",
        "idomap:order": 5,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48422,
          40.74964
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Horrea (Forum granaries)",
        "idomap:description": "Large public warehouses on the west side of the Forum. Today they display thousands of artefacts recovered from the excavations, as well as several plaster casts of victims of the eruption.",
        "idomap:order": 6,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48442,
          40.74921
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Temple of Apollo",
        "idomap:description": "One of the oldest sanctuaries in Pompeii, dating to the 6th century BC, with clear Etruscan and Greek influences. Famous bronze statues of Apollo and Diana as archers once stood facing each other across the courtyard.",
        "idomap:order": 7,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48372,
          40.74842
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Temple of Venus",
        "idomap:description": "Dedicated to Venus Pompeiana, patron goddess of the Roman colony founded by Sulla in 80 BC. Overlooks the sea to the south; largely destroyed by the earthquake of 62 AD and still under reconstruction when Vesuvius erupted.",
        "idomap:order": 8,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48827,
          40.74918
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Temple of Isis",
        "idomap:description": "A small but richly decorated temple devoted to the Egyptian goddess Isis, whose cult was popular in Pompeii. One of the first buildings to be fully restored after the 62 AD earthquake. Its rediscovery in 1764 fascinated Mozart, who may have drawn inspiration from it for The Magic Flute.",
        "idomap:order": 9,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48446,
          40.75073
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Temple of Fortuna Augusta",
        "idomap:description": "A small marble temple built at private expense by the magistrate Marcus Tullius in honor of the goddess Fortuna and the deified Emperor Augustus.",
        "idomap:order": 10,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48862,
          40.74931
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Temple of Asclepius",
        "idomap:description": "A small temple sometimes identified as a shrine to Zeus Meilichios. Features a terracotta altar and painted cult statues unusually well preserved.",
        "idomap:order": 11,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48412,
          40.75034
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Forum Baths",
        "idomap:description": "Built shortly after the foundation of the Roman colony in 80 BC, with separate sections for men and women. Famous for its well-preserved stucco decoration and the vivid frescoes of the tepidarium.",
        "idomap:order": 12,
        "idomap:groupId": "grp-baths",
        "idomap:legendEntryId": "09ebd059-754f-57ac-948f-2c20ac394317"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48756,
          40.74999
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Stabian Baths",
        "idomap:description": "The oldest and largest bath complex in Pompeii, built in the 4th century BC and repeatedly renovated. Features a palaestra, swimming pool and richly stuccoed ceilings in the changing rooms.",
        "idomap:order": 13,
        "idomap:groupId": "grp-baths",
        "idomap:legendEntryId": "09ebd059-754f-57ac-948f-2c20ac394317"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48678,
          40.75155
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Central Baths",
        "idomap:description": "An enormous new bath complex still under construction at the time of the eruption. Designed with large glass windows — a luxurious novelty — but never finished.",
        "idomap:order": 14,
        "idomap:groupId": "grp-baths",
        "idomap:legendEntryId": "09ebd059-754f-57ac-948f-2c20ac394317"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48278,
          40.74868
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Suburban Baths",
        "idomap:description": "A private bath complex built into the city walls just outside the Porta Marina. Famous for its erotic frescoes in the changing room, the only known visual depiction of several sexual practices from Roman daily life.",
        "idomap:order": 15,
        "idomap:groupId": "grp-baths",
        "idomap:legendEntryId": "09ebd059-754f-57ac-948f-2c20ac394317"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.495149329238108,
          40.751340835834526
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Amphitheatre",
        "idomap:description": "The oldest surviving permanent stone amphitheatre in the Roman world, built around 70 BC — nearly 150 years before the Colosseum in Rome. Site of the infamous riot of 59 AD between Pompeians and visitors from nearby Nuceria, which led to a ten-year ban on gladiatorial games.",
        "idomap:order": 0,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.488669329238109,
          40.75124083947509
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Large Theatre",
        "idomap:description": "Built in the 2nd century BC in the Greek tradition, carved into the natural slope of a hill. Seated about 5,000 spectators for open-air plays and musical performances.",
        "idomap:order": 1,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.489289329238108,
          40.75125083911104
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Small Theatre (Odeon)",
        "idomap:description": "A covered theatre of about 1,500 seats, built around 80 BC and used for music recitals, poetry readings and small performances.",
        "idomap:order": 2,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.489149329238108,
          40.75077085658566
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Quadriporticus of the Theatres",
        "idomap:description": "A large rectangular colonnade behind the theatres, originally a foyer for spectators. After the 62 AD earthquake it was converted into a barracks for gladiators — 18 of whom were found here, still wearing their ornate bronze armor.",
        "idomap:order": 3,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.494159329238109,
          40.75316076957475
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Great Palaestra",
        "idomap:description": "A vast 141 × 107 m exercise ground next to the amphitheatre, ringed by a colonnade. Plane trees planted along the perimeter have been regrown in their original post-holes. A swimming pool filled the center.",
        "idomap:order": 4,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.488219329238108,
          40.75145083182986
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Samnite Palaestra",
        "idomap:description": "An older, smaller exercise ground from the pre-Roman Samnite period, used for athletic training by Pompeian youth.",
        "idomap:order": 5,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.488409329238108,
          40.750930850760795
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Triangular Forum",
        "idomap:description": "A triangular colonnaded plaza built around an ancient Doric temple from the 6th century BC. A quiet, contemplative space offering views towards the sea.",
        "idomap:order": 6,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.487059329238107,
          40.7527107859579
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Lupanar",
        "idomap:description": "The largest and most famous brothel of Pompeii, a two-story building with ten small stone-bed cubicles and explicit erotic frescoes advertising the services on offer. Graffiti left by clients cover the walls.",
        "idomap:order": 7,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48454,
          40.75137
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Faun",
        "idomap:description": "The largest and most luxurious house in Pompeii, covering an entire city block of nearly 3,000 m². Named after a bronze statue of a dancing faun found in its atrium. Home of the extraordinary Alexander Mosaic, now in the Naples Archaeological Museum.",
        "idomap:order": 24,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48457,
          40.75209
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Vettii",
        "idomap:description": "The residence of two wealthy freedmen brothers, Aulus Vettius Restitutus and Aulus Vettius Conviva. Famous for its exuberant Fourth-Style frescoes depicting mythological scenes and winged cupids, recently restored in 2023.",
        "idomap:order": 25,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48378,
          40.75075
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Tragic Poet",
        "idomap:description": "A modest but finely decorated house featured in Bulwer-Lytton's 1834 novel The Last Days of Pompeii. Its entrance hall has the famous 'Cave Canem' ('Beware of the Dog') mosaic.",
        "idomap:order": 26,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48999,
          40.74979
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Menander",
        "idomap:description": "A large and richly decorated house belonging to a relative of the Empress Poppaea. Named for a fresco of the Greek playwright Menander in its peristyle. A secret storeroom held a spectacular hoard of silverware, now in the Naples Museum.",
        "idomap:order": 27,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48498,
          40.75226
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Golden Cupids",
        "idomap:description": "An elegant aristocratic residence named after the gold-leaf decorations of its peristyle, where cupids were engraved in gold leaf on glass medallions. A private shrine to Isis reveals its owner's devotion to the Egyptian cult.",
        "idomap:order": 28,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48258,
          40.75119
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Sallust",
        "idomap:description": "One of the oldest houses in Pompeii, dating to the 4th century BC, with a grand atrium in the Samnite tradition. Partially destroyed by a bomb in 1943 during Allied air raids on the site.",
        "idomap:order": 29,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48186,
          40.75162
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Surgeon",
        "idomap:description": "A 4th-century BC Samnite house where bronze surgical instruments were found in 1771 — among the earliest archaeological evidence of ancient Roman surgical practice.",
        "idomap:order": 30,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.4837,
          40.75177
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Dioscuri",
        "idomap:description": "A large aristocratic dwelling named after the frescoes of Castor and Pollux — the twin Dioscuri — that adorned its entrance.",
        "idomap:order": 31,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48967,
          40.75013
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Cryptoporticus",
        "idomap:description": "Features a rare underground cryptoporticus, a covered passage originally decorated with frescoes depicting scenes from the Iliad.",
        "idomap:order": 32,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48801,
          40.75292
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Lucretius Fronto",
        "idomap:description": "A small but exquisite house whose frescoes are considered among the finest examples of the Third Pompeian style, with delicate miniature landscapes.",
        "idomap:order": 33,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.49278,
          40.75181
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Venus in the Shell",
        "idomap:description": "A large residence on the Via dell'Abbondanza named after a large fresco in its garden of the goddess Venus reclining in a seashell, floating among cupids and dolphins.",
        "idomap:order": 34,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.47753,
          40.75372
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Villa of the Mysteries",
        "idomap:description": "A grand suburban villa outside the city walls, famous worldwide for the 'Dionysiac Frieze' — a series of life-sized figures painted around 60–50 BC depicting the initiation rites of the cult of Dionysus. One of the finest and most enigmatic paintings to survive from antiquity.",
        "idomap:order": 35,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.47865,
          40.75239
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Villa of Diomedes",
        "idomap:description": "A large suburban villa outside the Porta Ercolano. Eighteen victims of the eruption were found huddled in its cellar, including the owner's family still holding their jewelry and household keys.",
        "idomap:order": 36,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48912,
          40.75029
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Fullonica of Stephanus",
        "idomap:description": "A fullery (Roman laundry) where togas and tunics were cleaned using urine collected from public basins. The process — trodden underfoot in large tubs — is illustrated in frescoes on the walls.",
        "idomap:order": 37,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48309,
          40.74851
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta Marina",
        "idomap:description": "The western gate of the city, facing the sea. Its steep ramp gives access to the Forum area. The main entrance used by visitors today.",
        "idomap:order": 38,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48111,
          40.75183
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta Ercolano (Herculaneum Gate)",
        "idomap:description": "The northwestern gate on the road to Herculaneum, lined on both sides by an elaborate necropolis of funerary monuments.",
        "idomap:order": 39,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.4841,
          40.75338
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta del Vesuvio",
        "idomap:description": "The northern gate, looking directly up the slopes of Mount Vesuvius. The city's main water castellum, which distributed aqueduct water throughout Pompeii, stood just inside.",
        "idomap:order": 40,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.4908,
          40.75372
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta di Nola",
        "idomap:description": "The northeastern gate on the road to the ancient town of Nola, with a well-preserved inscription in the Oscan language above its arch.",
        "idomap:order": 41,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.49442,
          40.75281
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta di Sarno",
        "idomap:description": "The eastern gate on the road toward the Sarno river, whose valley was the agricultural hinterland that made Pompeii prosperous.",
        "idomap:order": 42,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.49344,
          40.74951
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta di Nocera",
        "idomap:description": "The southeastern gate leading toward the town of Nuceria, whose inhabitants clashed with Pompeians in the deadly amphitheatre riot of 59 AD.",
        "idomap:order": 43,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48996,
          40.74833
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Porta di Stabia",
        "idomap:description": "The southern gate on the road to the port of Stabiae, where Pliny the Elder died during the 79 AD eruption while attempting to rescue survivors.",
        "idomap:order": 44,
        "idomap:groupId": "grp-gates",
        "idomap:legendEntryId": "98e4ff6f-9f18-5ab7-a84d-6dce4b27583f"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48006,
          40.75234
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Necropolis of Porta Ercolano",
        "idomap:description": "An elaborate city of the dead lining both sides of the road outside the Herculaneum Gate, with tombs ranging from modest altars to grand funerary monuments of the wealthiest Pompeian families.",
        "idomap:order": 45,
        "idomap:groupId": "grp-necro",
        "idomap:legendEntryId": "3487a634-2014-55b8-8991-1e2e098798f3"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48408,
          40.75375
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Necropolis of Porta Vesuvio",
        "idomap:description": "A funerary area outside the Vesuvius Gate, containing tombs from the Samnite and Roman periods, including the monumental tomb of the priestess Mamia.",
        "idomap:order": 46,
        "idomap:groupId": "grp-necro",
        "idomap:legendEntryId": "3487a634-2014-55b8-8991-1e2e098798f3"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.49389,
          40.7493
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Necropolis of Porta Nocera",
        "idomap:description": "The largest necropolis of Pompeii, lining the road towards Nuceria. Its long row of tombs includes the monumental sepulchre of Eumachia.",
        "idomap:order": 47,
        "idomap:groupId": "grp-necro",
        "idomap:legendEntryId": "3487a634-2014-55b8-8991-1e2e098798f3"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.492849329238108,
          40.75195081362685
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Garden of the Fugitives",
        "idomap:description": "A vineyard inside the city where thirteen plaster casts of victims of the eruption are displayed exactly where they fell. Among the most haunting sights of Pompeii, showing families huddled together as they tried to flee the advancing pyroclastic flow.",
        "idomap:order": 8,
        "idomap:groupId": "grp-ent",
        "idomap:legendEntryId": "9f50846e-47fe-543d-8cb8-f9b45befcf97"
      }
    },
