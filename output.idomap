        "idomap:order": 3,
        "idomap:groupId": "6672914d-17ad-46b2-8450-41fab5d8a5cb",
        "idomap:legendEntryId": "0e1c250c-fe15-42f4-a3f6-a120ee96da70"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48876,
          40.74989
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Citharist",
        "idomap:description": "Among the largest houses in Pompeii (Regio I, insula 4), named after a bronze statue of Apollo playing the cithara found in one of its three peristyles. Owned by the influential Popidii family, it reflects the wealth of Pompeian aristocracy before 79 AD.",
        "idomap:order": 48,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48955,
          40.75054
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Paquius Proculus",
        "idomap:description": "A domus famous for its mosaic entrance showing a chained guard dog under the inscription 'cave canem' — 'beware of the dog'. The atrium floor features an elaborate marine mosaic with fish and birds.",
        "idomap:order": 49,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.49244,
          40.75177
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Octavius Quartio",
        "idomap:description": "Also known as the House of Loreius Tiburtinus. Notable for its elaborate garden with a long canal (euripus) and two biclinia for outdoor dining, imitating the grand villa style within the city walls.",
        "idomap:order": 50,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.49335,
          40.75203
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Praedia of Julia Felix",
        "idomap:description": "A sprawling complex owned by Julia Felix, daughter of Spurius. After the 62 AD earthquake she rented parts of her estate — including baths, shops and an inn — as shown by a painted rental notice still visible on the facade.",
        "idomap:order": 51,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48615,
          40.75199
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Caecilius Iucundus",
        "idomap:description": "Home of a prominent Pompeian banker and auctioneer. His financial archive — 154 waxed wooden tablets recording transactions — was found here, providing a vivid window into the commercial life of the city.",
        "idomap:order": 52,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48655,
          40.7525
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Silver Wedding",
        "idomap:description": "Named in 1893 in honour of the silver wedding anniversary of King Umberto I and Queen Margherita of Italy. One of the most imposing houses of Pompeii, with a monumental Tuscan atrium and a large colonnaded peristyle.",
        "idomap:order": 53,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48846,
          40.75284
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Gladiators",
        "idomap:description": "Served as a gladiators' barracks and training school in the last years of the city. Excavated painted inscriptions record the names and victories of the fighters who lived and trained here.",
        "idomap:order": 54,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48331,
          40.75083
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Pansa",
        "idomap:description": "An entire insula-sized domus (about 2,800 m²), originally built in the Samnite period. Its owner rented out shops and apartments along the facade, showing how even the largest houses doubled as income properties.",
        "idomap:order": 55,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48343,
          40.75238
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Meleager",
        "idomap:description": "Named after a painting of Meleager and Atalanta found near the entrance. The house is notable for its elegant peristyle with a marble basin, a rare example of refined late-Republican decoration.",
        "idomap:order": 56,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48522,
          40.75229
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Orpheus",
        "idomap:description": "Named after a large wall painting depicting Orpheus charming the animals with his lyre. The house preserves elaborate Fourth Style frescoes in its main reception rooms.",
        "idomap:order": 57,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48633,
          40.75063
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Bear",
        "idomap:description": "Takes its name from the mosaic in the fauces entryway showing a wounded bear. A modest but finely decorated house, typical of the middle-class dwellings of Regio VII.",
        "idomap:order": 58,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48596,
          40.74883
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Cornelius Rufus",
        "idomap:description": "A domus remarkable for the marble herm of its owner — inscribed 'Cornelius Rufus' — still standing in the atrium where it was found, one of the rare in-situ portrait busts at Pompeii.",
        "idomap:order": 59,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48798,
          40.75208
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of the Centenary",
        "idomap:description": "One of Pompeii's largest houses, discovered in 1879 on the 18th centenary of the eruption — hence the name. Features a private bath suite, a nymphaeum, and a famous fresco showing Vesuvius as a single-peaked mountain covered in vines, next to Bacchus draped in grapes — one of the only known depictions of the volcano before 79 AD.",
        "idomap:order": 60,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48725,
          40.75083
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Inn of Sittius",
        "idomap:description": "A commercial inn (caupona) marked by a painted elephant sign and the Latin motto 'Sittius restituit elepantu[m]'. It offered rooms and meals to travellers arriving from the nearby Stabian gate.",
        "idomap:order": 61,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48687,
          40.75098
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "House of Gaius Rufus",
        "idomap:description": "A middle-sized atrium house in Regio VII, still partially unexcavated. Belongs to the dense residential quarter surrounding the Stabian Baths.",
        "idomap:order": 62,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48821,
          40.75029
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Tannery",
        "idomap:description": "A workshop where hides were soaked, scraped and tanned in a series of large masonry vats still visible on site — one of the best-preserved Roman tanneries known. The process was smelly and relegated to the city's edge.",
        "idomap:order": 63,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48723,
          40.75093
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Bakery",
        "idomap:description": "One of Pompeii's 33 identified bakeries, equipped with lava-stone millstones turned by donkeys and a domed oven. Carbonised loaves were found still inside some Pompeii ovens at the time of excavation.",
        "idomap:order": 64,
        "idomap:groupId": "grp-houses",
        "idomap:legendEntryId": "2c90b136-602f-5e08-be26-f46a19a649dd"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48519,
          40.7496
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Temple of Vespasian",
        "idomap:description": "A small imperial-cult temple on the east side of the Forum, dedicated to the worship of the emperor Vespasian. Its marble altar — still in place — is carved with a relief of a bull being led to sacrifice.",
        "idomap:order": 65,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48502,
          40.74975
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Sanctuary of the Public Lares",
        "idomap:description": "An open-air precinct on the east side of the Forum, dedicated to the protective household gods of the Roman state. Built shortly after the 62 AD earthquake as a thanksgiving for the city's survival.",
        "idomap:order": 66,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48799,
          40.74829
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Doric Temple",
        "idomap:description": "The oldest temple in Pompeii, built in the 6th century BC within the Triangular Forum. Originally dedicated to Hercules and Athena, only the base and a few column fragments survive today.",
        "idomap:order": 67,
        "idomap:groupId": "grp-temples",
        "idomap:legendEntryId": "a6b69053-7b1c-58e3-8f4e-7c76e5f87adb"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48465,
          40.749
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Curia",
        "idomap:description": "One of three civic halls at the southern end of the Forum, where the city council (ordo decurionum) of Pompeii held its meetings. Paved in coloured marble, it was still unfinished when Vesuvius erupted.",
        "idomap:order": 68,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48494,
          40.74927
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Tabularium",
        "idomap:description": "The municipal archive building, where Pompeii's legal and administrative records were stored. Stands in a row with the Curia and the office of the Duumvirs at the south end of the Forum.",
        "idomap:order": 69,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.4845,
          40.7489
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Office of the Duumvirs",
        "idomap:description": "Seat of the two duumviri, the elected chief magistrates of Pompeii. Together with the Curia and the Tabularium, it formed the civic government quarter on the south side of the Forum.",
        "idomap:order": 70,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48416,
          40.75322
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Castellum Aquae",
        "idomap:description": "The city's main water distribution point, where the aqueduct from Serino entered Pompeii at its highest point next to the Vesuvius gate. From here lead pipes fed the public fountains, baths and private houses below.",
        "idomap:order": 71,
        "idomap:groupId": "grp-forum",
        "idomap:legendEntryId": "bf0f0a84-c997-5acd-8dea-934b7b9b8b39"
      }
    },
    {
      "type": "Feature",
      "geometry": {
        "type": "Point",
        "coordinates": [
          14.48541,
          40.74808
        ]
      },
      "properties": {
        "idomap:type": "point",
        "idomap:layerId": "default",
        "idomap:label": "Sarno Baths",
        "idomap:description": "A large multi-level bath complex perched on Pompeii's southern slope, with panoramic terraces overlooking the Sarno river plain. Built late in the city's life, it was still being finished at the time of the eruption.",
        "idomap:order": 72,
        "idomap:groupId": "grp-baths",
        "idomap:legendEntryId": "09ebd059-754f-57ac-948f-2c20ac394317"
      }
    }
  ]
}